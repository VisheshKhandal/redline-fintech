# Server-only configuration; copy to .env for local development.
# Set these in Vercel Project Settings > Environment Variables.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_POOLER_HOST/YOUR_DATABASE?sslmode=require"
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
# Vercel: exact canonical HTTPS origin, without /api/auth.
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID="YOUR_GOOGLE_OAUTH_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_OAUTH_CLIENT_SECRET"
GITHUB_CLIENT_ID="YOUR_GITHUB_OAUTH_CLIENT_ID"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_OAUTH_CLIENT_SECRET"
# Sandbox only; the SDK environment is fixed to sandbox.
POLAR_ACCESS_TOKEN="YOUR_POLAR_SANDBOX_ACCESS_TOKEN"
# Non-secret ID; must match REDLINE_PRO_PRODUCT_ID in billing-core.mjs.
POLAR_PRO_PRODUCT_ID="101f32f7-ae31-4680-bc3c-a006fff94e06"
# Leave empty until the real Sandbox webhook signing secret is configured.
# Missing secret rejects webhook delivery; API reconciliation still works.
POLAR_WEBHOOK_SECRET=""
